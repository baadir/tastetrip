APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
DATA_DIR=./data
PORT=8080
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
AVIASALES_API_TOKEN=
AVIASALES_PARTNER_ID=


# Twilio - planned voice integration; configuration alone does not enable calling.
# Copy Account SID and Auth Token from Twilio Console. Keep Auth Token private.
# FROM_NUMBER: an account-authorized caller number in E.164 format (+countrycode...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Speech recognition for planned voice agent
DEEPGRAM_API_KEY=

VOICE_PUBLIC_URL=

VOICE_MONITOR_TOKEN=

ELEVENLABS_API_KEY=

ELEVENLABS_VOICE_ID=XZXyuzPdidXaSa10PmVA

ELEVENLABS_VOICE_ID_TR=XZXyuzPdidXaSa10PmVA

ELEVENLABS_VOICE_ID_EN=XZXyuzPdidXaSa10PmVA

# Fixed authorized personal test target, E.164
TWILIO_TEST_TO_NUMBER=
# Product reservation services (same shared secret is used by web, worker and gateway)
RESERVATION_WEB_URL=http://127.0.0.1:8080
VOICE_GATEWAY_INTERNAL_URL=http://127.0.0.1:8081
VOICE_GATEWAY_HOST=127.0.0.1
VOICE_GATEWAY_PORT=8081
RESERVATION_DAILY_LIMIT=10
# Production Compose disables the local fixed-number demo buttons.
DISABLE_DEMO_CALLS=false
